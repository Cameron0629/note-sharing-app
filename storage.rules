rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read any file
    match /notes/{userId}/{fileName} {
      allow read: if request.auth != null;
      // Allow users to upload files to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow users to delete files they uploaded
      allow delete: if request.auth != null;
    }
    
    // Profile pictures
    match /profile-pictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      // Allow users to upload/update their own profile picture
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow users to delete their own profile picture
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}

